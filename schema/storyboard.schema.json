{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short Storyboard",
  "type": "object",
  "required": [
    "project",
    "shots"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "title_am",
        "title_en",
        "language",
        "subtitle_language",
        "target_duration_seconds"
      ],
      "properties": {
        "title_am": {
          "type": "string"
        },
        "title_en": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "subtitle_language": {
          "type": "string"
        },
        "target_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_seconds",
          "narration_am",
          "subtitle_en",
          "visual_prompt",
          "motion_prompt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "narration_am": {
            "type": "string",
            "minLength": 1
          },
          "subtitle_en": {
            "type": "string",
            "minLength": 1
          },
          "visual_prompt": {
            "type": "string",
            "minLength": 1
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}